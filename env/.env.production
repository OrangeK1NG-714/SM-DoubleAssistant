# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'production'
# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = true
# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = false

# 后端接口地址（生产环境）
VITE_SERVER_BASEURL = 'https://richardq.tech'
VITE_API_SECONDARY_URL = 'https://richardq.tech'
VITE_UPLOAD_BASEURL = 'https://richardq.tech/upload'

# 微信小程序环境区分
VITE_SERVER_BASEURL__WEIXIN_DEVELOP = 'https://richardq.tech'
VITE_SERVER_BASEURL__WEIXIN_TRIAL = 'https://richardq.tech'
VITE_SERVER_BASEURL__WEIXIN_RELEASE = 'https://richardq.tech'
VITE_UPLOAD_BASEURL__WEIXIN_DEVELOP = 'https://richardq.tech/upload'
VITE_UPLOAD_BASEURL__WEIXIN_TRIAL = 'https://richardq.tech/upload'
VITE_UPLOAD_BASEURL__WEIXIN_RELEASE = 'https://richardq.tech/upload'
